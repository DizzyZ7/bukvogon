# Core services
POSTGRES_DB=bukvogon
POSTGRES_USER=bukvogon
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bukvogon:change-me@postgres:5432/bukvogon

REDIS_URL=redis://redis:6379/0

# Weekly encrypted Telegram backups
# Create an age key OFF the production server:
#   age-keygen -o bukvogon-backup-key.txt
# Copy only the printed public recipient (age1...) here.
BACKUP_AGE_RECIPIENT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_RETENTION_DAYS=35

# Restore-only values are intentionally not required by the scheduled backup.
# Keep the private age identity OFF the production server when possible.
BACKUP_AGE_IDENTITY_FILE=
RESTORE_POSTGRES_HOST=postgres
RESTORE_POSTGRES_PORT=5432
RESTORE_POSTGRES_DB=bukvogon
RESTORE_POSTGRES_USER=bukvogon
RESTORE_POSTGRES_PASSWORD=change-me
